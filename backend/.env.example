# ─────────────────────────────────────────────────────────────────────────────
# NHL Draft Simulator — Backend Environment Variables
#
# Copy this file to .env and fill in the values.
# Required in production: DATABASE_URL, REDIS_URL, ADMIN_API_KEY,
#                         ANTHROPIC_API_KEY, VOYAGE_API_KEY
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string. Must use pgvector/pgvector:pg16 image.
DATABASE_URL=postgresql+psycopg2://nhl:nhl_password@localhost:5432/nhl_draft

# Optional read replica for Scout agent tools (falls back to primary if unset).
DATABASE_READ_REPLICA_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# [REQUIRED] Redis connection string. Used for draft simulation result caching
# and model version sync across instances.
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────────────────────────
# Set to "production" or "staging" in non-local environments.
# Controls: auth bypass (dev only), HSTS header, startup config checks.
APP_ENV=development
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# [REQUIRED in production] Used by FastAPI internals for session signing.
SECRET_KEY=change-me-in-production

LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Security ──────────────────────────────────────────────────────────────────
# [REQUIRED in production] Protects all /api/admin/* and /api/ml/train endpoints.
# Missing in non-dev environments → 503 on all protected endpoints at startup.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# [REQUIRED] Claude API key for "Ask the Scout" agent and draft summaries.
# Obtain from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# Claude model used for chat and summaries.
# Options: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama base URL for local RAG embeddings (nomic-embed-text, 768-dim).
# No API key required — Ollama runs locally or as a sidecar container.
# Before starting the server run: ollama pull nomic-embed-text
# In Docker Compose, set this to http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Optional: JSON array of MCP server configs for the Scout agent.
# Example: '[{"type":"url","url":"https://mcp.example.com","name":"hockey-stats"}]'
MCP_SERVERS=

# ── NHL API ───────────────────────────────────────────────────────────────────
NHL_API_BASE_URL=https://api-web.nhle.com/v1

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# S3 bucket for model artifact persistence across container restarts.
# Leave empty to store model only on local filesystem (lost on restart).
AWS_S3_BUCKET=

# Secrets Manager secret name. When set, secrets are fetched from AWS at startup
# and merged with env vars (AWS values take precedence).
# Leave empty to use plain environment variables.
AWS_SECRETS_NAME=

# CloudWatch Logs group for structured log shipping.
# Leave empty to log to stdout only.
AWS_CLOUDWATCH_LOG_GROUP=

# ── Lambda / API Gateway ──────────────────────────────────────────────────────
# API Gateway URL for admin operations delegated to Lambda.
# Leave empty to use local FastAPI admin endpoints (recommended for dev).
LAMBDA_API_GATEWAY_URL=

# ── SQS ───────────────────────────────────────────────────────────────────────
# SQS queue URL for async RAG index rebuild jobs.
# When set, POST /api/agent/index returns immediately and a Lambda consumer
# calls build_index() from the queue. Leave empty for synchronous rebuild (dev).
SQS_INDEX_QUEUE_URL=

# ── Error tracking & observability ───────────────────────────────────────────
# Sentry DSN. Leave empty to disable Sentry (local dev, CI).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# OpenTelemetry collector endpoint (e.g. http://otel-collector:4317).
# Leave empty to disable distributed tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nhl-draft-api
